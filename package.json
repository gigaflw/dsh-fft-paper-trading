{
  "name": "@dsh-ft/dsh-fft-paper-trading",
  "version": "0.6.0",
  "description": "A-share and commodity futures paper trading for DeepSeek Harness: local ledger, batch orders, review, and FTShare quotes.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "Ben <ben@ft.tech>",
  "homepage": "https://github.com/gigaflw/dsh-fft-paper-trading#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigaflw/dsh-fft-paper-trading.git"
  },
  "bugs": {
    "url": "https://github.com/gigaflw/dsh-fft-paper-trading/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "paper-trading",
    "trading-simulator",
    "a-share",
    "futures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.png",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "verify:translation": "node scripts/verify-translation-pairing.mjs",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "dependencies": {
    "@dsh-ft/dsh-fft-settings": "^0.5.0",
    "@dsh-ft/dsh-fft-ftshare": "^0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.15.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "release": {
    "klineRef": "v0.4.0-ft.2"
  }
}
